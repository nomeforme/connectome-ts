# Connectome gRPC Server Dockerfile
# Build context should be the parent /opt/connectome directory

FROM node:20-slim

# Install build dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /workspace

# Copy all necessary packages (build context is parent directory)
COPY connectome-axon-interfaces ./connectome-axon-interfaces
COPY connectome-grpc ./connectome-grpc
COPY connectome-ts ./connectome-ts

# Build connectome-axon-interfaces
WORKDIR /workspace/connectome-axon-interfaces
RUN npm install && npm run build

# Build connectome-grpc
WORKDIR /workspace/connectome-grpc
RUN npm install && npm run build

# Build connectome-ts
WORKDIR /workspace/connectome-ts
RUN npm install && npm run build

# Create state directory
RUN mkdir -p /workspace/connectome-ts/state

# Set working directory for runtime
WORKDIR /workspace/connectome-ts

# Environment variables with defaults
ENV NODE_ENV=production
ENV GRPC_PORT=50051
ENV GRPC_HOST=0.0.0.0
ENV PERSISTENCE_ENABLED=true
ENV PERSISTENCE_DIR=/workspace/connectome-ts/state
ENV DEBUG_ENABLED=false
ENV DEBUG_PORT=3015

# Expose ports
EXPOSE 50051
EXPOSE 3015

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD node -e "require('net').connect(process.env.GRPC_PORT || 50051).on('error', () => process.exit(1)).on('connect', () => process.exit(0))"

# Run the gRPC server
CMD ["node", "dist/grpc-main.js"]
