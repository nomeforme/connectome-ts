{
  "name": "connectome-ts",
  "version": "0.1.0",
  "description": "Experimental TypeScript implementation of Connectome without DAG",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts",
    "test": "jest",
    "grpc-server": "tsx src/grpc-main.ts",
    "grpc-server:dev": "nodemon --watch src --exec tsx src/grpc-main.ts",
    "grpc-server:reset": "tsx src/grpc-main.ts --reset",
    "example:console": "tsx examples/console-chat-host.ts",
    "example:dispenser": "ts-node examples/dispenser-with-host.ts",
    "example:dispenser:reset": "ts-node examples/dispenser-with-host.ts --reset",
    "example:dispenser:debug": "ts-node examples/dispenser-with-host.ts --debug-llm",
    "example:compression": "ts-node examples/compression-retm-demo.ts",
    "session-server": "ts-node src/testing/start-session-server.ts",
    "session-server:dev": "nodemon --watch src/testing --exec ts-node src/testing/start-session-server.ts",
    "session-server:mcp": "SESSION_SERVER_PORT=3101 ts-node src/testing/start-session-server.ts",
    "debug-mcp": "ts-node src/testing/debug-mcp-stdio.ts",
    "mcp-server": "ts-node src/testing/mcp-stdio-server.ts",
    "session-cli": "ts-node src/testing/session-cli.ts"
  },
  "keywords": [
    "llm",
    "agent",
    "veil",
    "connectome"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/dotenv": "^6.1.1",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "chokidar": "^3.5.3",
    "discord.js": "^14.24.2",
    "dotenv": "^17.2.2",
    "esbuild": "^0.19.11",
    "eslint": "^8.0.0",
    "express": "^4.18.2",
    "jest": "^29.0.0",
    "js-yaml": "^4.1.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.0.0",
    "typescript": "^5.0.0",
    "ws": "^8.16.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.61.0",
    "@connectome/axon-interfaces": "file:../connectome-axon-interfaces",
    "@connectome/grpc": "file:../connectome-grpc",
    "@modelcontextprotocol/sdk": "^1.11.2",
    "@types/node-fetch": "^2.6.13",
    "fengari": "^0.1.4",
    "fengari-interop": "^0.1.3",
    "node-fetch": "^3.3.2",
    "node-pty": "^1.0.0",
    "strip-ansi": "^7.1.0",
    "tsx": "^4.7.0"
  }
}
